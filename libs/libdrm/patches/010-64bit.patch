From: lean <chenlin@fnnas.com>
Subject: [PATCH] libdrm: use sane userspace integer types

Retain the OpenWrt libdrm package compatibility adjustment for PPC64.

Signed-off-by: lean <chenlin@fnnas.com>

--- a/include/drm/drm.h
+++ b/include/drm/drm.h
@@ -37,6 +37,9 @@
 
 #if   defined(__linux__)
 
+#ifndef __SANE_USERSPACE_TYPES__
+#define __SANE_USERSPACE_TYPES__	/* For PPC64, to get LL64 types */
+#endif
 #include <linux/types.h>
 #include <asm/ioctl.h>
 typedef unsigned int drm_handle_t;
